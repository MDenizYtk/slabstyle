# ── Uygulama ───────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:4920
# showcase = vitrin (ürün + fotoğraf + WhatsApp ile iletişim; sepet/ödeme/stok kapalı)
# shop     = tam mağaza (sepet, ödeme, sipariş, stok, tedarikçi senkronizasyonu)
STORE_MODE=showcase

# ── Veritabanı ─────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/slabstyle?schema=public
# Entegrasyon testleri için ayrı veritabanı
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/slabstyle_test?schema=public

# ── Redis (cache, rate limit, kuyruk) ──────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Güvenlik ───────────────────────────────────────────────
# Tedarikçi kimlik bilgilerini şifrelemek için 32 baytlık anahtar (base64).
# Üretmek için: openssl rand -base64 32
ENCRYPTION_KEY=

# Oturum süresi (gün)
SESSION_TTL_DAYS=30

# ── Ödeme (Aşama 7'de doldurulacak) ────────────────────────
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=

# ── Seed ───────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@slabstyle.local
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# ── Canlı ortam ────────────────────────────────────────────
# Site Cloudflare proxy (turuncu bulut) arkasındaysa 1: gerçek müşteri IP'si CF-Connecting-IP'den okunur.
TRUST_CLOUDFLARE=0
# Fotoğrafların saklanacağı klasör (varsayılan: ./storage/uploads)
# UPLOAD_DIR=
# Yüklenen fotoğraflar otomatik küçültülür. Daha az yer için düşürün (ör. 1000 / 70).
IMAGE_MAX_EDGE=1400
IMAGE_QUALITY=75

# ── Kuyruk ────────────────────────────────────────────────
# 1 ise sipariş/sync işleri kuyruk yerine istek içinde çalışır (yalnızca yerel geliştirme).
QUEUE_INLINE=0
# Üretimde MOCK ödeme sağlayıcısını kullanmaya izin (demo ortamı için).
ALLOW_MOCK_PAYMENTS=0
# Üretimde tedarikçi adreslerinin özel ağ IP adresi olmasına izin
ALLOW_PRIVATE_SUPPLIER_HOSTS=0
