{
  "name": "slabstyle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4920",
    "build": "next build",
    "start": "next start -p 4920",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "worker": "tsx scripts/worker.ts",
    "test:integration": "sh -c 'if [ -f .env ]; then set -a; . ./.env; set +a; fi; DATABASE_URL=$TEST_DATABASE_URL prisma migrate deploy && vitest run -c vitest.integration.config.mts'"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.4",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.1",
    "ioredis": "^6.0.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true,
    "msgpackr-extract@3.0.4": true
  }
}
